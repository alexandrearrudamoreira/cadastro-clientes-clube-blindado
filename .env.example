# Google Drive Configuration
# ID da pasta onde os PDFs serão salvos
# Obter: Google Drive -> [2-Processamento] -> URL contém /folders/{FOLDER_ID}
GOOGLE_DRIVE_FOLDER_ID=1KcR1VDwRTd9wVJF2H6Pio7heuk1aBQwU

# OAuth 2.0 Credentials
# IMPORTANTE: Este é um JSON completo com as credenciais do Google Cloud
# Obter: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# Copiar o arquivo JSON baixado e converter para string de uma linha
# Para desenvolvimento local, pode ser um arquivo oauth-credentials.json em vez desta variável
OAUTH_CREDENTIALS_JSON={"installed":{"client_id":"xxx.apps.googleusercontent.com","client_secret":"***","redirect_uris":["http://localhost:3000/auth/callback"],...}}

# Port (opcional)
# Default: 3000 (local) ou porta alocada pelo Railway (produção)
PORT=3000

# Environment
# local | production
NODE_ENV=local
